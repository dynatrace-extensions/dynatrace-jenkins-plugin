<?xml version="1.0" encoding="UTF-8"?>
<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
    <f:section title="Dynatrace">
        <f:entry title="${%Dynatrace Tenant}" field="tenant">
            <f:textbox/>
        </f:entry>
        <f:entry title="${%Dynatrace API Token}" field="apiToken">
            <f:password/>
        </f:entry>
        <f:entry title="${%Proxy Url}" field="proxyUrl">
            <f:textbox/>
        </f:entry>
        <f:entry title="${%Proxy Username}" field="proxyUsername">
            <f:textbox/>
        </f:entry>
        <f:entry title="${%Proxy Password}" field="proxyPassword">
            <f:password/>
        </f:entry>
        <f:entry title="Filesystem Metrics Enabled" field="filesystemMetricsEnabled">
            <f:checkbox default="true" checked="${instance.filesystemMetricsEnabled}" />
        </f:entry>

        <f:entry title="Executor Metrics Enabled" field="executorMetricsEnabled">
            <f:checkbox default="true" checked="${instance.executorMetricsEnabled}" />
        </f:entry>

        <f:entry title="Job Log Enabled" field="jobLogEnabled">
            <f:checkbox default="true" checked="${instance.jobLogEnabled}" />
        </f:entry>
    </f:section>
</j:jelly>
